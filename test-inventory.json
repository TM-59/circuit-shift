{
  "version": 1,
  "repository": "TM-59/circuit-shift",
  "entrypoints": {
    "test": "make test",
    "check": "make check"
  },
  "kinds": {
    "unit": {
      "framework": "pytest",
      "requirements": [
        "REQ-HEALTH",
        "REQ-CORE",
        "REQ-TILE",
        "REQ-CONNECT",
        "REQ-BOARD",
        "REQ-USECASE"
      ]
    },
    "integration": {
      "framework": "pytest",
      "requirements": ["REQ-PERSISTENCE", "REQ-ATOMIC"]
    },
    "e2e": {
      "reason": "Deferred until the playable screen in M4."
    },
    "perf": {
      "reason": "No gameplay or measurable performance contract in M1."
    },
    "mem": {
      "reason": "No simulation or persistence workload in M1."
    },
    "visual": {
      "reason": "No browser screen in M1."
    },
    "infra": {
      "reason": "No deployed infrastructure."
    },
    "trace": {
      "reason": "Ordered domain-event persistence is covered by REQ-PERSISTENCE integration tests."
    }
  }
}
